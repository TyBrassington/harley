{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WildChat anchor evidence extraction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "source_prompt_sha256",
    "eligibility",
    "language",
    "task_summary",
    "response_or_action",
    "must_preserve",
    "immutable_payloads",
    "candidate_behaviors",
    "alignment_evidence_quotes",
    "target_adjacent_cues",
    "uncertainty_reasons"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "wildchat_anchor_evidence_v2"},
    "candidate_id": {"type": "string"},
    "source_prompt_sha256": {"type": "string"},
    "eligibility": {"type": "string", "enum": ["eligible", "hold"]},
    "language": {"type": "string"},
    "task_summary": {"type": ["string", "null"]},
    "response_or_action": {"type": ["string", "null"]},
    "must_preserve": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1}
    },
    "immutable_payloads": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_behaviors": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior_family", "behavior_mechanism", "current_turn_evidence_quotes"],
        "properties": {
          "behavior_family": {"type": "string", "minLength": 1},
          "behavior_mechanism": {"type": "string", "minLength": 1},
          "current_turn_evidence_quotes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "alignment_evidence_quotes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_adjacent_cues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "uncertainty_reasons": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
